{
  "expo": {
    "name": "BizFlow Access",
    "slug": "bizflow-access",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bizflowaccess",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#8b6a3a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bizflow.access",
      "infoPlist": {
        "NSCameraUsageDescription": "Este app precisa de acesso à câmera para escanear QR codes.",
        "NSPhotoLibraryUsageDescription": "Este app precisa de acesso à galeria para selecionar imagens."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8b6a3a"
      },
      "package": "com.bizflow.access",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "API_URL": "http://localhost:3000"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa de acesso às suas fotos para upload de imagens."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O app precisa de acesso à câmera para funcionalidades de QR Code."
        }
      ]
    ]
  }
}
