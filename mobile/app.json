{
  "expo": {
    "name": "Salon Booking",
    "slug": "salon-booking-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salonbooking",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6efe6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salonbooking.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Este app precisa de acesso à câmera para fotos de perfil e produtos.",
        "NSLocationWhenInUseUsageDescription": "Este app usa sua localização para encontrar unidades próximas.",
        "NSPhotoLibraryUsageDescription": "Este app precisa de acesso à galeria para selecionar fotos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f6efe6"
      },
      "package": "com.salonbooking.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8b6a3a"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Este app precisa de acesso à câmera para fotos de perfil e produtos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Este app usa sua localização para encontrar unidades próximas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Este app precisa de acesso à galeria para selecionar fotos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.salonbooking.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    }
  }
}
